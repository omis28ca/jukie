{
  "name": "@jukie/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Jukie jukebox server: Fastify + Prisma + Socket.IO + mpv",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "mqtt": "^5.10.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
