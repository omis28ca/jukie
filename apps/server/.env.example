PORT=3000
HOST=0.0.0.0
DATABASE_URL="file:./dev.db"

# Four-digit PIN required for admin actions.
ADMIN_PIN="1234"
# Optional absolute URL guests should open (used for the join QR code). Auto-detected when unset.
PUBLIC_URL=

# Drive/folder that holds the music library. Jukie creates uploads/, artwork/ and imports/ inside
# it, and an admin can change this at runtime from the Admin page (the saved value wins).
STORAGE_ROOT="../../storage"
# Optional per-directory overrides; leave unset to follow STORAGE_ROOT.
UPLOAD_DIR="../../storage/uploads"
ARTWORK_DIR="../../storage/artwork"
# Drop one folder per mood here. Successful imports are removed automatically.
IMPORT_DIR="../../storage/imports"
# A folder must remain unchanged for this long before import begins.
IMPORT_SETTLE_MS=10000
IMPORT_POLL_MS=5000

MAX_UPLOAD_MB=5120
ALLOWED_AUDIO_EXTENSIONS=".mp3,.mp4,.wav,.m4a,.flac"

# Optional official YouTube Data API v3 key. Search results are links only.
YOUTUBE_API_KEY=
# Maximum size for an authorized public-domain audio import.
EXTERNAL_IMPORT_MAX_MB=250
# Total storage quota for public-domain external imports.
EXTERNAL_LIBRARY_MAX_MB=5120

# yt-dlp powers the "YouTube download" tab, which saves a link into the folder-import inbox.
# Omit if yt-dlp is already on PATH. Only download material you have the right to use.
YTDLP_EXEC=
YTDLP_MAX_FILE_MB=500
YTDLP_MAX_PLAYLIST_ITEMS=50
YTDLP_TIMEOUT_MS=1800000
# Player clients retried when YouTube rejects the default one. Empty disables the retry.
YTDLP_FALLBACK_CLIENTS=android,mweb,tv_simply
# Extra yt-dlp arguments appended to every download (for example --cookies /path/cookies.txt).
YTDLP_ARGS=

# Set to loopback when nginx on this host proxies requests to preserve client-IP rate limits.
TRUST_PROXY=

# Optional MQTT bridge for home automation remote control and audio output control.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=jukie

# Full path to mpv binary — omit if mpv is already on PATH
# Windows example: PLAYER_EXEC=C:\tools\mpv\mpv.exe
# Ubuntu: leave unset (mpv from apt is on PATH)
PLAYER_EXEC=
# Runtime IPC ownership record used to stop orphaned playback after a restart.
PLAYER_STATE_FILE="../../storage/player-state.json"
# Full path to ffprobe binary — omit if ffprobe is already on PATH
AUDIO_PROBE_EXEC=
# Full path to ffmpeg binary used for extracting embedded artwork
AUDIO_TRANSCODE_EXEC=

# Built web app served by the server in production.
WEB_DIST_DIR="../web/dist"
