generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Song {
  id              String   @id @default(uuid())
  title           String
  artist          String?
  album           String?
  genre           String?
  year            Int?
  filename        String
  path            String
  mimeType        String?
  artworkFilename String?
  artworkMimeType String?
  artworkPath     String?
  duration        Int?
  uploadedBy      String?
  sourceProvider  String?
  sourceId        String?
  sourceUrl       String?
  licenseUrl      String?
  createdAt       DateTime @default(now())

  queueItems QueueItem[]
  moodSongs  MoodSong[]

  @@unique([sourceProvider, sourceId])
  @@index([createdAt])
  @@index([title])
}

model QueueItem {
  id           String   @id @default(uuid())
  songId       String
  song         Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  requestedBy  String?
  requesterKey String   @default("")
  status       String   @default("queued")
  playNext     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  votes QueueItemVote[]

  @@index([status, playNext, createdAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([requesterKey, status])
}

model QueueItemVote {
  id          String    @id @default(uuid())
  queueItemId String
  queueItem   QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  voterKey    String
  kind        String    @default("down")
  createdAt   DateTime  @default(now())

  @@unique([queueItemId, voterKey])
  @@index([queueItemId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Mood {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  songs     MoodSong[]

  @@index([name])
}

model MoodSong {
  id       String @id @default(uuid())
  moodId   String
  mood     Mood   @relation(fields: [moodId], references: [id], onDelete: Cascade)
  songId   String
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  position Int

  @@unique([moodId, position])
  @@unique([moodId, songId])
  @@index([moodId, position])
  @@index([songId])
}

model FolderImport {
  id          String   @id
  sourceName  String
  workingName String
  status      String   @default("processing")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}
